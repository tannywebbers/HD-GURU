# ---------------------------------------------------------------------------
# HD Guru - Backend environment configuration
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=HD Guru
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) --------------------------------------------------
# Local development. For Docker, compose overrides this to `postgres`.
DATABASE_URL=postgresql+psycopg://hdguru:hdguru@localhost:5432/hdguru

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Set to true in tests / local no-worker setups to run tasks inline.
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false

# --- JWT ----------------------------------------------------------------------
# MUST be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-random-secret-of-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS / Hosts -------------------------------------------------------------
# Comma-separated list of allowed origins. Use * for development only.
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# --- Upload rules -------------------------------------------------------------
STORAGE_DIR=./storage
# RUNTIME-MANAGED fallback: the live value is `upload.ttl_hours` in the DB
# (Admin -> Settings); this env var is only used the first time it is seeded.
DEFAULT_UPLOAD_TTL_HOURS=24
MAX_UPLOAD_COUNT=5
MAX_UPLOAD_FILES=5
MAX_FILE_SIZE_MB=100
MAX_UPLOAD_SIZE_MB=500
# Comma-separated allowed MIME types (images + videos).
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff,image/heic,image/heif,video/mp4,video/quicktime,video/x-m4v,video/webm,video/x-msvideo,video/x-matroska

# --- Media processing pipeline --------------------------------------------------
# Storage backend: 'local' or 's3' (S3-compatible: Cloudflare R2 / AWS S3 / MinIO).
STORAGE_DRIVER=local

# --- S3-compatible object storage (Cloudflare R2 / AWS S3 / MinIO) --------------
# Only required when STORAGE_DRIVER=s3. Credentials are never logged or returned
# to clients. For Cloudflare R2 use the bucket's S3 API endpoint, e.g.
#   https://<account-id>.r2.cloudflarestorage.com
# and set S3_REGION=auto.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
# Public URL prefix when the bucket (or a CDN/custom domain in front of it) is
# public, e.g. https://media.example.com. Used only with MEDIA_URL_MODE=public.
# For R2 this is your <custom-domain> or <bucket>.<account-id>.r2.dev URL.
S3_PUBLIC_BASE_URL=
# Set true for MinIO-style endpoints that do not support virtual-host style.
S3_FORCE_PATH_STYLE=false

# How processed media URLs are handed to clients.
#   public -> direct public URL built from S3_PUBLIC_BASE_URL
#   signed -> short-lived pre-signed URL (works even for private buckets)
# Local storage always falls back to the app's own /uploads/{id}/file route.
MEDIA_URL_MODE=public
# Lifetime of generated signed URLs (seconds) when MEDIA_URL_MODE=signed.
MEDIA_SIGNED_URL_EXPIRES=3600

# Maximum input size (MB) per image / video.
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=100
# Target maximum output size (MB) after processing.
MAX_IMAGE_OUTPUT_SIZE_MB=5
MAX_VIDEO_OUTPUT_SIZE_MB=16
# Longest image edge after processing (pixels).
MAX_IMAGE_OUTPUT_DIMENSION=2048
# Video dimension caps (portrait 1080x1920 / landscape 1920x1080 / square 1080x1080).
MAX_VIDEO_WIDTH=1920
MAX_VIDEO_HEIGHT=1080
# Video quality floor: highest CRF allowed while shrinking to the size target.
MIN_VIDEO_QUALITY=28

# --- Rate limiting --------------------------------------------------------------
# RUNTIME-MANAGED fallback: the live value is `rate_limit.enabled` in the DB
# (Admin -> Settings); this env var is only used the first time it is seeded.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# --- Email delivery (password reset links) ----------------------------------------
# EMAIL_BACKEND=smtp sends via SMTP; =console prints the message to the log so a
# developer can read the reset link (development only - refused in production).
EMAIL_ENABLED=false
EMAIL_BACKEND=console
# SMTP settings (required when EMAIL_BACKEND=smtp). Credentials are secret and
# must never be exposed to the frontend (never use NEXT_PUBLIC_* for these).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Base URL of the password-reset page on the frontend; the single-use token is
# appended as a query parameter. The API never returns the token.
PASSWORD_RESET_URL=

# --- Seed admin (optional, created on first startup) ------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- WhatsApp Business Cloud API --------------------------------------------------
# RUNTIME-MANAGED: the live configuration is stored in the DB and edited at
# runtime from Admin -> WhatsApp (PUT /api/v1/whatsapp/config). The variables
# below are optional fallbacks used ONLY the first time a key is seeded; a
# DB value always wins over env afterwards. No redeploy needed to change them.
WHATSAPP_ENABLED=false
# Meta WhatsApp Business API access token (system user token with the
# whatsapp_business_messaging + whatsapp_business_management permissions).
WHATSAPP_ACCESS_TOKEN=
# Phone number ID for the business line (found in Meta Business Manager →
# WhatsApp account → API setup). Numeric string.
WHATSAPP_PHONE_NUMBER_ID=
# The business line itself, E.164 with leading + and country code, e.g. +15551234567.
# Used by the frontend to build the wa.me click-to-chat link. Optional.
WHATSAPP_PHONE_NUMBER=
# WhatsApp Business Account ID (numeric). Optional, informational.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Webhook verify token you enter in the Meta App Dashboard when registering the
# callback URL. The GET verification handshake must echo it.
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta App Dashboard. Used to validate the
# X-Hub-Signature-256 header on every webhook POST.
WHATSAPP_APP_SECRET=
# Graph API version and base URL (base + version + phone number id form the
# messages/media endpoints). Override the base URL only for proxies/staging.
WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
# Local backstop against runaway sending; Meta enforces its own per-tier limits.
WHATSAPP_MAX_SENDS_PER_MINUTE=100
WHATSAPP_SEND_TIMEOUT_SECONDS=30
# Public base URL of the API, used to build downloadable media links for
# WhatsApp when storage is local (e.g. https://api.example.com). Not needed
# when STORAGE_DRIVER=s3 with MEDIA_URL_MODE=public/signed.
APP_PUBLIC_BASE_URL=

# --- Advertising & analytics (Phase 7) ------------------------------------------
# RUNTIME-MANAGED: all of these are edited at runtime from Admin -> Ads /
# Admin -> Settings. The variables below are optional fallbacks used ONLY the
# first time each key is seeded; a DB value always wins over env afterwards.
ADS_ENABLED=false
# Provider name used by placements that have no explicit provider assigned.
ADS_DEFAULT_PROVIDER=
# 'lazy' (load when the slot nears the viewport) or 'eager' (load at mount).
ADS_DEFAULT_PLACEMENT_BEHAVIOR=lazy
# Master toggle for traffic analytics.
ANALYTICS_ENABLED=true
# Raw analytics/ad event rows are purged after this many days. Aggregated
# daily stats are kept indefinitely.
ANALYTICS_RETENTION_DAYS=90
# Ingest budget per client (hashed IP) to stop fake analytics floods.
ANALYTICS_EVENTS_PER_MINUTE=120
AD_EVENTS_PER_MINUTE=60

# --- Watermark ---------------------------------------------------------------------
# RUNTIME-MANAGED: the watermark master switch and the watermark itself are
# edited at runtime from Admin -> Settings / Admin -> Watermark. The variable
# below is an optional fallback used ONLY the first time the key is seeded; a
# DB value always wins over env afterwards.
WATERMARK_ENABLED=true
