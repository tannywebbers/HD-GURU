# ---------------------------------------------------------------------------
# HD Guru - Frontend environment configuration
# Copy this file to `.env.local` (local dev) or configure these in Vercel
# (Project Settings -> Environment Variables) for production.
# NEVER put secrets in NEXT_PUBLIC_* variables - they are shipped to the
# browser bundle. The backend owns all secrets (Meta tokens, R2 keys, JWT).
# ---------------------------------------------------------------------------

# Public API base URL of the deployed backend (Render).
# Without it the app runs in demo mode with mock data.
# Example: https://hd-guru-api.onrender.com
NEXT_PUBLIC_API_URL=

# Public origin of THIS frontend. Used for SEO metadata, sitemap/robots and
# PWA manifest icon URLs. Falls back to https://hdguru.vercel.app when unset.
# Example: https://hdguru.vercel.app
NEXT_PUBLIC_APP_URL=
